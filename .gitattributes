# Blob bytes are evidence: this repository's receipts, fixtures, profiles,
# and source anchors are digest-bound, so no checkout or archive may
# rewrite line endings anywhere. (Scripts that need a guaranteed LF form
# pin it explicitly below.)
* -text
*.sh text eol=lf
docs/snapshots/**/assurance/** text eol=lf
# opi-eval evidence bytes: benchmark task packages, profiles, and saved native
# bytes are digest-pinned; any checkout must reproduce them byte for byte, so
# no CRLF normalization may touch them.
crates/opi-eval/tests/fixtures/** -text
crates/opi-eval/profiles/** -text
crates/opi-eval/scripts/fixtures/** -text
# Capture helpers and their tests are digest-bound evidence inputs.
*.py -text
# Captured package tests end with a blank line that is part of the receipt hash.
scripts/pi-sdk-conformance/evidence/phase*-package*/*-tests.stdout whitespace=-blank-at-eof
# Differential receipts (phase5-* fixtures) pin the exact CRLF bytes of these
# two inputs: keep them byte-identical and exempt only CR at EOL from the
# scope gate. Other files in this repository are LF.
crates/opi-ai/tests/data/incremental-argument-preview.json whitespace=cr-at-eol
scripts/pi-sdk-conformance/differential/tools/observe_chat_finish_consumers.mjs whitespace=cr-at-eol
# SSE fixture streams end with the blank line that terminates the last event.
crates/opi-ai/tests/data/*.sse whitespace=-blank-at-eof

*.rs diff=rust
