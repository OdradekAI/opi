!.claude/skills/opi-audit/**
!.claude/skills/opi-remediate/
!.claude/skills/opi-remediate/**
!.claude/skills/opi-document/
!.claude/skills/opi-document/**
!.claude/skills/opi-release/
!.claude/skills/opi-release/**
!.claude/skills/opi-realign/
!.claude/skills/opi-realign/**
