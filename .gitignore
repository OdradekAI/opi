# Codex/agent local-only state
.agents/
/.scratch/

# Local third-party skill packs (e.g. baoyu-translate), not tracked
.baoyu-skills/

# Secrets / credentials (must never be committed)
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.toml

# Local project config (may contain provider base_url, model overrides)
.opi/config.toml

# Release skill resume state
.opi-release-state.json

# Release artifacts (uploaded to GitHub Release, not tracked)
release-notes.md
/release-artifacts/

# opi-implement transient/recovery state (canonical ledger is tracked)
.opi-impl-state.json.tmp
.opi-impl-state.draft.json
.opi-impl-state.corrupt-*
.opi-impl-state.*candidate*.json
.opi-impl-state.*backup*.json
.opi-impl-state.pre-*.json
