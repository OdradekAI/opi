+fn storage_length(current: usize, additional: usize) -> Result<usize, Error> {
+    current.checked_add(additional)
+        .filter(|length| *length <= isize::MAX as usize)
+        .ok_or_else(|| StorageError::Capacity.into())
+}
+
+fn reserve_storage(buffer: &mut Vec<u8>, capacity: usize) -> Result<(), Error> {
+    storage_length(0, capacity)?;
+    buffer.try_reserve_exact(capacity).map_err(|error| StorageError::Allocation(error).into())
+}
+
+fn append_storage(buffer: &mut BytesMut, bytes: &[u8]) -> Result<(), Error> {
+    if bytes.is_empty() { return Ok(()); }
+    let required = storage_length(buffer.len(), bytes.len())?;
+    if buffer.try_reclaim(bytes.len()) {
+        buffer.extend_from_slice(bytes);
+        return Ok(());
+    }
+    let capacity = buffer.capacity().checked_mul(2)
+        .filter(|capacity| *capacity <= isize::MAX as usize)
+        .unwrap_or(required).max(required);
+    let mut replacement = Vec::new();
+    if let Err(error) = reserve_storage(&mut replacement, capacity) {
+        if capacity == required { return Err(error); }
+        reserve_storage(&mut replacement, required)?;
+    }
+    replacement.extend_from_slice(buffer);
+    replacement.extend_from_slice(bytes);
+    *buffer = Bytes::from(replacement).try_into_mut().map_err(|_| StorageError::Ownership)?;
+    Ok(())
 }
 
