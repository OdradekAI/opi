+/// Local buffer representation or bulk-allocation failure.
+#[derive(Debug, Error)]
+pub enum StorageError {
+    /// A length cannot be represented by this buffer implementation.
+    #[error("buffer representation overflow")]
+    Capacity,
+    /// A fallible bulk reservation failed.
+    #[error("buffer reservation failed: {0}")]
+    Allocation(#[source] std::collections::TryReserveError),
+    /// A uniquely owned buffer could not be converted without copying.
+    #[error("buffer ownership conversion failed")]
+    Ownership,
+}
+
+impl From<StorageError> for Error {
+    fn from(e: StorageError) -> Self {
+        Error::with_cause(ErrorKind::Storage, e)
+    }
+}
